$TTL    604800
@       IN      SOA     ns1.tas13.local. admin.tas13.local. (
                     2026101601         ; Serial
                         604800         ; Refresh
                          86400         ; Retry
                        2419200         ; Expire
                         604800 )       ; Negative Cache TTL
;
@       IN      NS      ns1.tas13.local.

